<?php
/** Спільний каркас редакційних добірок із налаштуваннями окремого сайту. */
if (!defined('ABSPATH')) { exit; }
$lc = json_decode(file_get_contents(__DIR__ . '/listicle-data.json'), true);
$lc_home = is_front_page();
$lc_blog = is_home() || is_page('blog') || is_category() || is_author();
$lc_title = $lc_home ? $lc['title'] : ($lc_blog ? 'Reading guides & articles' : get_the_title());
$lc_profiles = json_decode(file_get_contents(__DIR__ . '/assets/listicles/profiles.json'), true);
$lc_nebula_experts = $lc_home ? json_decode(file_get_contents(__DIR__ . '/asknebula-experts.json'), true) : [];
// Відокремлюємо нову сторінку від старих глобальних стилів теми.
add_action('wp_enqueue_scripts', function () {
    global $wp_styles;
    foreach ((array) $wp_styles->queue as $handle) { if (!str_contains($handle, 'wpnc')) { wp_dequeue_style($handle); } }
}, 9999);
add_filter('pre_get_document_title', function ($title) use ($lc, $lc_home) {
    return $lc_home ? $lc['brand'] . ' | Reader Shortlists & Guides' : $title;
}, 9999);
add_filter('wpseo_title', function ($title) use ($lc, $lc_home) {
    return $lc_home ? $lc['brand'] . ' | Reader Shortlists & Guides' : $title;
}, 9999);
add_filter('wpseo_metadesc', function ($description) use ($lc, $lc_home) {
    return $lc_home ? $lc['intro'] : $description;
}, 9999);
?><!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<?php wp_head(); ?>
<?php if (!defined('WPSEO_VERSION')): $lc_description=$lc_home ? $lc['intro'] : wp_trim_words(wp_strip_all_tags(get_post_field('post_content',get_queried_object_id())),28); ?>
<meta name="description" content="<?php echo esc_attr($lc_description); ?>"><meta property="og:title" content="<?php echo esc_attr($lc_home ? $lc['brand'].' | Reader Shortlists & Guides' : $lc_title); ?>"><meta property="og:description" content="<?php echo esc_attr($lc_description); ?>"><meta property="og:type" content="website"><meta property="og:url" content="<?php echo esc_url($lc_home ? home_url('/') : get_permalink()); ?>"><meta property="og:image" content="<?php echo esc_url(get_stylesheet_directory_uri().'/assets/listicles/'.$lc['ids'][0].'.webp'); ?>">
<?php endif; ?>
<link rel="stylesheet" href="<?php echo esc_url(get_stylesheet_directory_uri() . '/listicle.css?v=20261021'); ?>">
</head><body class="lc-site lc-<?php echo esc_attr($lc['palette']); ?>">
<?php wp_body_open(); ?>
<a class="lc-skip" href="#main">Skip to content</a>
<div class="lc-topline">Reader profiles. Thoughtful comparisons. Your choice.</div>
<header class="lc-header"><div class="lc-header-inner"><a class="lc-brand" href="/"><span class="lc-mark" aria-hidden="true"><?php echo $lc['id'] === 48 ? '◈' : '✳'; ?></span><span><?php echo esc_html($lc['brand']); ?></span></a><button class="lc-menu" type="button" aria-expanded="false" aria-controls="lc-nav">Menu <span aria-hidden="true">☰</span></button><nav id="lc-nav" aria-label="Main navigation"><a href="/#shortlist">Reader shortlist</a><a href="/blog/">Articles</a><a href="/how-we-build-shortlists/">Our approach</a><a class="lc-nav-cta" href="<?php echo esc_url('/' . $lc['topics'][0][0] . '/'); ?>">Explore readers →</a></nav></div></header>
<main id="main">
<?php if ($lc_home): ?>
<section class="lc-hero"><div class="lc-hero-copy"><span class="lc-kicker"><?php echo esc_html($lc['eyebrow']); ?></span><h1><?php echo esc_html($lc['title']); ?></h1><p><?php echo esc_html($lc['intro']); ?></p><a class="lc-button" href="#shortlist">Meet the readers <span aria-hidden="true">↗</span></a><a class="lc-quiet-link" href="/how-we-build-shortlists/">How we choose</a><div class="lc-hero-note"><span aria-hidden="true">✓</span> Clear profiles. No promises about your future.</div></div><div class="lc-hero-visual"><div class="lc-portrait-grid"><?php foreach (array_slice($lc_profiles, 0, 4) as $n => $reader): ?><a href="#reader-<?php echo (int) $reader['id']; ?>" class="lc-hero-person"><img src="<?php echo esc_url(get_stylesheet_directory_uri() . '/assets/listicles/' . $reader['id'] . '.webp'); ?>" alt="<?php echo esc_attr($reader['name']); ?>" width="320" height="360" <?php echo $n > 1 ? 'loading="lazy"' : ''; ?>><span><?php echo esc_html($reader['name']); ?> <b aria-hidden="true">↗</b></span></a><?php endforeach; ?></div><div class="lc-visual-caption"><span class="lc-caption-line"></span> Different voices. A choice that feels like yours.</div></div></section>
<div class="lc-principles"><span>Compare specialties</span><span>Find your reading style</span><span>Check the provider’s terms</span><span>Decide at your own pace</span></div>
<section class="lc-section" id="guides"><div class="lc-heading"><div><span class="lc-kicker">START WITH YOUR QUESTION</span><h2>A shorter route to your shortlist.</h2></div><p>Choose a topic. Compare the people.<br>Keep what matters to you in focus.</p></div><div class="lc-topics"><?php foreach ($lc['topics'] as $topic): ?><a class="lc-topic" href="<?php echo esc_url('/' . $topic[0] . '/'); ?>"><span class="lc-kicker"><?php echo esc_html($topic[2]); ?></span><h3><?php echo esc_html($topic[1]); ?></h3><span class="lc-text-link">Explore the list <span aria-hidden="true">↗</span></span></a><?php endforeach; ?></div></section>
<section class="lc-section lc-shortlist" id="shortlist"><div class="lc-heading"><div><span class="lc-kicker">MEET THE READERS</span><h2><?php echo esc_html($lc['section']); ?></h2></div></div><p class="lc-standfirst"><?php echo esc_html($lc['standfirst']); ?></p><div class="lc-editor-note"><strong>A note on this list.</strong> Selected for their stated specialties and styles. Numbers help you navigate; they are not accuracy scores. Details come from saved provider profiles, not live availability. <a href="/how-we-build-shortlists/">Our method →</a></div><div class="lc-readers"><?php readfile(__DIR__ . '/listicle-home.html'); ?></div></section>
<section class="lc-section lc-nebula" id="nebula-advisors"><div class="lc-heading"><div><span class="lc-kicker">ON ASKNEBULA</span><h2>Four advisors to explore</h2></div></div><p class="lc-standfirst">These advisors have public profiles on AskNebula. Compare their stated methods, then check their current details before starting a session.</p><div class="lc-nebula-grid"><?php foreach ($lc_nebula_experts as $expert): ?><article class="lc-nebula-card"><span class="lc-nebula-monogram" aria-hidden="true"><?php echo esc_html(substr($expert['name'], 0, 1)); ?></span><div><span class="lc-kicker">ASKNEBULA ADVISOR</span><h3><?php echo esc_html($expert['name']); ?></h3><p class="lc-nebula-focus"><?php echo esc_html($expert['focus']); ?></p><p><?php echo esc_html($expert['summary']); ?></p><p class="lc-nebula-methods"><strong>Methods listed:</strong> <?php echo esc_html($expert['methods']); ?></p></div><a class="lc-button" href="/sign-up/" rel="sponsored nofollow">Explore on AskNebula</a></article><?php endforeach; ?></div><p class="lc-nebula-note">Based on public AskNebula profiles checked 21 October 2026. We have not tested these advisors. Availability, methods and terms can change; the sign-up flow may show other advisors. Partner links may earn us a commission.</p></section>
<section class="lc-consider"><div><span class="lc-kicker">BEFORE YOUR FIRST CONVERSATION</span><h2>Three small checks.<br>A more useful reading.</h2></div><ol><li><h3>Know your question.</h3><p>Choose something you want to reflect on. Focus on decisions you can make, rather than certainty about someone else’s feelings.</p></li><li><h3>Set your boundaries.</h3><p>Decide on a budget and session length. Check how the provider bills, and whether you can stop when you choose.</p></li><li><h3>Leave room for your judgment.</h3><p>A reading offers a perspective. You decide what is useful, what to set aside and whether to continue.</p></li></ol></section>
<section class="lc-section lc-faq"><div><span class="lc-kicker">GOOD QUESTIONS TO ASK</span><h2>A little clarity<br>before you book.</h2></div><div><details><summary>How were these readers chosen?</summary><p>We looked for documented provider profiles with a photograph, stated specialties and enough information to compare reading styles. The lists show a range of approaches; they do not measure psychic accuracy.</p></details><details><summary>Have you personally tested these readers?</summary><p>No. We describe information from saved provider profiles. The partner button leads to AskNebula, a separate service. We do not claim first-hand readings, independent vetting or verified outcomes.</p></details><details><summary>Are the prices and schedules current?</summary><p>Check each provider’s current rates and availability. The AskNebula button leads to that service’s own readers and terms; our saved profiles are not a live booking feed.</p></details><details><summary>Can a reading predict a relationship outcome?</summary><p>A reading cannot establish another person’s private feelings or guarantee a reunion. Respect other people’s boundaries and make decisions using observable actions and your own judgment.</p></details></div></section>
<?php else: ?>
<section class="lc-article-head"><a href="/">← <?php echo esc_html($lc['brand']); ?></a><span class="lc-kicker">THE READER GUIDE</span><h1><?php echo esc_html($lc_title); ?></h1></section><div class="lc-article-body <?php echo !$lc_blog && !is_page_template('page-listicle.php') ? 'lc-legacy-prose' : ''; ?>"><?php if ($lc_blog): $articles = new WP_Query(['post_type'=>'post','post_status'=>'publish','posts_per_page'=>100]); ?><div class="lc-topics"><?php while($articles->have_posts()): $articles->the_post(); ?><a class="lc-topic" href="<?php the_permalink(); ?>"><span class="lc-kicker">READING GUIDE</span><h3><?php the_title(); ?></h3><span class="lc-text-link">Read the article →</span></a><?php endwhile; wp_reset_postdata(); ?></div><?php else: while (have_posts()): the_post(); the_content(); endwhile; endif; ?></div>
<?php endif; ?>
</main><footer class="lc-footer"><div class="lc-footer-top"><div><a class="lc-brand" href="/"><?php echo esc_html($lc['brand']); ?></a><p>Make space for perspective.<br>Keep the choice yours.</p></div><div><strong>Explore</strong><?php foreach ($lc['topics'] as $topic): ?><a href="<?php echo esc_url('/' . $topic[0] . '/'); ?>"><?php echo esc_html($topic[2]); ?></a><?php endforeach; ?></div><div><strong>About this guide</strong><a href="/how-we-build-shortlists/">Our selection method</a><?php foreach (['about'=>'About us','contact'=>'Contact','blog'=>'Articles','about-us'=>'About us','privacy-policy'=>'Privacy policy','terms'=>'Terms','terms-of-service'=>'Terms of service','disclaimer'=>'Disclaimer','cookie-policy'=>'Cookie policy','contact-us'=>'Contact'] as $slug=>$label) { $p=get_page_by_path($slug); if ($p && $p->post_status === 'publish') echo '<a href="' . esc_url(get_permalink($p)) . '">' . esc_html($label) . '</a>'; } ?></div></div><div class="lc-footer-bottom"><span>© <?php echo esc_html(date('Y') . ' ' . $lc['brand']); ?></span><p>For reflection and entertainment. No guaranteed outcomes. Not a substitute for professional advice.</p></div></footer>
<script>document.querySelector('.lc-menu').addEventListener('click',function(){var open=this.getAttribute('aria-expanded')!=='true';this.setAttribute('aria-expanded',String(open));document.getElementById('lc-nav').classList.toggle('is-open',open)});document.querySelectorAll('#lc-nav a').forEach(function(a){a.addEventListener('click',function(){document.querySelector('.lc-menu').setAttribute('aria-expanded','false');document.getElementById('lc-nav').classList.remove('is-open')})});</script>
<?php wp_footer(); ?>
</body></html>
